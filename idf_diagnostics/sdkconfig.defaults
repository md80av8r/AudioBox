# CrowPanel Advance 4.3: ESP32-S3-WROOM-1-N16R8 (16MB flash, 8MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_FREERTOS_HZ=1000

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_LED=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_USE_STDLIB_MALLOC_CLIB=y
CONFIG_LV_USE_STDLIB_STRING_CLIB=y
CONFIG_LV_USE_STDLIB_SPRINTF_CLIB=y
